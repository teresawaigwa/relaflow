---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout
  title="About Relaflow | Relationship Infrastructure Built for Sustainable Growth"
  description="Relaflow helps relationship-driven organizations bring research, data and operations together into systems that make growth sustainable."
>
  <PageHero
    eyebrow="About"
    title="About Us"
    lede="We help relationship-driven organizations build the systems behind their growth."
  />

  <section class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-20">
    <div class="max-w-3xl space-y-6 text-lg leading-relaxed text-white/80">
      <p>
        Relaflow works with organizations whose success depends on strong relationships
        with clients, partners, sponsors, members, communities and stakeholders.
      </p>

      <p>
        We bring together research, data and operations to help you find the right
        opportunities, manage relationships more effectively and build systems that
        support growth over time, not just for one campaign or one season.
      </p>
    </div>

    <div class="mt-12">
      <a
        href="/about/why-relaflow"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-teal hover:text-white"
      >
        Why Relaflow
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 14 14"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M2 7h10M8 3l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </section>
</Layout>