---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" description="This page doesn't exist.">
  <section class="mx-auto flex min-h-[60vh] max-w-content flex-col items-start justify-center px-6 md:px-10">
    <p class="font-display text-sm uppercase tracking-widest2 text-teal">404</p>
    <h1 class="mt-4 text-3xl sm:text-4xl">We couldn't find that page.</h1>
    <p class="mt-4 max-w-md text-white/70">
      The page you're looking for may have moved or no longer exists.
    </p>
    <a href="/" class="mt-8 rounded bg-teal px-6 py-3 text-sm font-medium text-navy hover:bg-teal-deep hover:text-white">
      Back to Home
    </a>
  </section>
</Layout>
