---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const helpOptions = [
  'Client Relationships',
  'Partnerships & Sponsorships',
  'Events & Communities',
  'Relationship Operations',
  'Research & Data',
  'Training & Workshops',
  'Other',
];

const submitted = Astro.url.searchParams.get('sent') === '1';
---

<Layout
  title="Contact Relaflow | Let's Talk"
  description="Tell Relaflow what you're working on, where you're facing a challenge, or what you're trying to build."
>
  <PageHero
    eyebrow="Contact"
    title="Let's talk."
    lede="Tell us what you're working on, where you're facing a challenge, or what you're trying to build."
  />

  {submitted && (
    <div class="mx-auto max-w-content px-6 pt-8 md:px-10">
      <div class="rounded border border-teal/30 bg-teal/10 px-5 py-4 text-sm text-white">
        Thank you. Your enquiry has been received. We’ll be in touch soon.
      </div>
    </div>
  )}

  <!-- Contact Form -->
  <section class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-20">
    <div class="grid gap-12 md:grid-cols-[1.3fr_1fr]">

      <form class="space-y-5" method="POST" action="/api/contact">

        <div class="grid gap-5 sm:grid-cols-2">

          <div>
            <label for="name" class="block text-sm text-white/70">
              Name
            </label>

            <input
              id="name"
              name="name"
              type="text"
              required
              class="mt-2 w-full rounded border border-white/15 bg-white/[0.03] px-4 py-3 text-sm text-white focus:border-teal"
            />
          </div>

          <div>
            <label for="email" class="block text-sm text-white/70">
              Work email
            </label>

            <input
              id="email"
              name="email"
              type="email"
              required
              class="mt-2 w-full rounded border border-white/15 bg-white/[0.03] px-4 py-3 text-sm text-white focus:border-teal"
            />
          </div>

        </div>

        <div>
          <label for="organization" class="block text-sm text-white/70">
            Organization
          </label>

          <input
            id="organization"
            name="organization"
            type="text"
            class="mt-2 w-full rounded border border-white/15 bg-white/[0.03] px-4 py-3 text-sm text-white focus:border-teal"
          />
        </div>

        <div>
          <label for="help" class="block text-sm text-white/70">
            What can we help with?
          </label>

          <select
            id="help"
            name="help"
            class="mt-2 w-full rounded border border-white/15 bg-navy px-4 py-3 text-sm text-white focus:border-teal"
          >
            {helpOptions.map((option) => (
              <option value={option}>{option}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm text-white/70">
            Tell us a little about what you're working on.
          </label>

          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="mt-2 w-full rounded border border-white/15 bg-white/[0.03] px-4 py-3 text-sm text-white focus:border-teal"
          ></textarea>
        </div>

        <button
          type="submit"
          class="rounded bg-teal px-6 py-3 text-sm font-medium text-navy transition-colors hover:bg-teal-deep hover:text-white"
        >
          Send Enquiry
        </button>

        <p class="text-xs text-white/45">
          Your information is used only to respond to your enquiry.
        </p>

      </form>

      <!-- Work With Relaflow -->
      <div class="border-t border-white/10 pt-10 md:border-t-0 md:border-l md:pl-12 md:pt-0">

        <h2 class="text-2xl sm:text-3xl">
          Work With Relaflow
        </h2>

        <p class="mt-5 text-sm leading-relaxed text-white/70">
          We work with organizations looking for insight, training, research or practical support around relationship-related challenges.
        </p>

        <p class="mt-4 text-sm leading-relaxed text-white/70">
          Whether you are exploring an opportunity, improving an existing process, developing your team's capabilities or looking for deeper project support, tell us what you're working on.
        </p>

        <a
          href="mailto:hello@relaflow.com"
          class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-teal hover:text-white"
        >
          Get in touch →
        </a>

        <div class="mt-12 border-t border-white/10 pt-8">

          <h2 class="font-display text-sm uppercase tracking-widest2 text-white/50">
            General Enquiries
          </h2>

          <a
            href="mailto:hello@relaflow.com"
            class="mt-3 inline-block text-lg text-teal hover:text-white"
          >
            hello@relaflow.com
          </a>

        </div>

      </div>

    </div>
  </section>
</Layout>