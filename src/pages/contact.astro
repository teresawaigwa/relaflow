---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const helpOptions = [
  'Partner & Sponsor Development',
  'Community Growth',
  'Relationship Operations',
  'Market & Stakeholder Intelligence',
  'Other',
];
---

<Layout
  title="Contact Relaflow | Talk to Us About Your Relationship Infrastructure"
  description="Tell Relaflow what you are working on, whether it is partnerships, community growth, CRM operations or stakeholder intelligence, and we will get back to you."
>
  <PageHero
    eyebrow="Contact"
    title="Let's talk."
    lede="Tell us what you are working on, where you are facing a challenge, or what you are trying to build."
  />

  <section class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-20">
    <div class="grid gap-12 md:grid-cols-[1.3fr_1fr]">
      <form class="space-y-5" method="POST" action="#">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="block text-sm text-white/70">
              Name
            </label>

            <input
              id="name"
              name="name"
              type="text"
              required
              class="mt-2 w-full rounded border border-white/15 bg-white/[0.03] px-4 py-3 text-sm text-white focus:border-teal"
            />
          </div>

          <div>
            <label for="email" class="block text-sm text-white/70">
              Work email
            </label>

            <input
              id="email"
              name="email"
              type="email"
              required
              class="mt-2 w-full rounded border border-white/15 bg-white/[0.03] px-4 py-3 text-sm text-white focus:border-teal"
            />
          </div>
        </div>

        <div>
          <label for="organization" class="block text-sm text-white/70">
            Organization
          </label>

          <input
            id="organization"
            name="organization"
            type="text"
            class="mt-2 w-full rounded border border-white/15 bg-white/[0.03] px-4 py-3 text-sm text-white focus:border-teal"
          />
        </div>

        <div>
          <label for="help" class="block text-sm text-white/70">
            What can we help with?
          </label>

          <select
            id="help"
            name="help"
            class="mt-2 w-full rounded border border-white/15 bg-navy px-4 py-3 text-sm text-white focus:border-teal"
          >
            {helpOptions.map((option) => (
              <option value={option}>{option}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm text-white/70">
            Tell us a little about what you're working on.
          </label>

          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="mt-2 w-full rounded border border-white/15 bg-white/[0.03] px-4 py-3 text-sm text-white focus:border-teal"
          ></textarea>
        </div>

        <button
          type="submit"
          class="rounded bg-teal px-6 py-3 text-sm font-medium text-navy transition-colors hover:bg-teal-deep hover:text-white"
        >
          Send Enquiry
        </button>

        <p class="text-xs text-white/45">
          Your information is used only to respond to your enquiry.
        </p>
      </form>

      <div class="border-t border-white/10 pt-10 md:border-t-0 md:border-l md:pl-12 md:pt-0">
        <h2 class="font-display text-sm uppercase tracking-widest2 text-white/50">
          Prefer email?
        </h2>

        <a
          href="mailto:hello@relaflow.com"
          class="mt-3 inline-block text-lg text-teal hover:text-white"
        >
          hello@relaflow.com
        </a>
      </div>
    </div>
  </section>
</Layout>