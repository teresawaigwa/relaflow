---
import Layout from '../layouts/Layout.astro';
import FlowLine from '../components/FlowLine.astro';
import Newsletter from '../components/Newsletter.astro';
---

<Layout
  title="Relaflow | Relationship Infrastructure for Sustainable Growth"
  description="Relaflow builds the systems that help organizations develop partnerships, grow communities, manage relationship data and understand their stakeholders."
>
  <!-- Hero -->
  <section class="mx-auto max-w-content px-6 pt-20 pb-16 md:px-10 md:pt-28 md:pb-24">
    <div class="max-w-3xl">
      <p class="font-display text-sm uppercase tracking-widest2 text-teal">
        Welcome to Relaflow
      </p>

      <h1 class="mt-5 text-4xl leading-[1.1] sm:text-5xl md:text-6xl">
        Systems for Sustainable Growth
      </h1>

      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-white/75">
        Relaflow builds the relationship infrastructure that helps organizations grow without losing control of the relationships that got them there.
      </p>

      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/75">
        We help you find and develop better partnerships, grow a community that sticks around, bring your relationship data into one working system, and understand the stakeholders who matter most to your future.
      </p>

      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/75">
        If any of that sounds familiar, you're in the right place.
      </p>
    </div>

    <FlowLine nodes={6} class="mt-16 h-8" />
  </section>

  <!-- What are you trying to improve? -->
  <section class="mx-auto max-w-content px-6 pb-20 md:px-10 md:pb-28">
    <h2 class="text-2xl sm:text-3xl">
      What are you trying to improve?
    </h2>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">

      <a
        href="/what-we-do/partner-sponsor-development"
        class="group rounded border border-white/10 p-6 transition-colors hover:border-teal/50 sm:p-8"
      >
        <h3 class="text-xl">
          I want to find and develop better partnerships
        </h3>

        <p class="mt-3 text-sm leading-relaxed text-white/65">
          Find relevant opportunities, build a stronger pipeline and put real systems behind how you develop partner and sponsor relationships, from first conversation to long-term renewal.
        </p>

        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-teal">
          Partner & Sponsor Development →
        </span>
      </a>

      <a
        href="/what-we-do/community-growth"
        class="group rounded border border-white/10 p-6 transition-colors hover:border-teal/50 sm:p-8"
      >
        <h3 class="text-xl">
          I want to grow and retain my community
        </h3>

        <p class="mt-3 text-sm leading-relaxed text-white/65">
          Understand who your community actually is, strengthen engagement where it counts and build the systems that support growth without burning people out.
        </p>

        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-teal">
          Community Growth →
        </span>
      </a>

      <a
        href="/what-we-do/relationship-operations"
        class="group rounded border border-white/10 p-6 transition-colors hover:border-teal/50 sm:p-8"
      >
        <h3 class="text-xl">
          I need better systems for managing relationships
        </h3>

        <p class="mt-3 text-sm leading-relaxed text-white/65">
          Bring your relationship data together in one place, with CRM structures, workflows and automation that actually get used, not just set up and abandoned.
        </p>

        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-teal">
          Relationship Operations →
        </span>
      </a>

      <a
        href="/what-we-do/market-stakeholder-intelligence"
        class="group rounded border border-white/10 p-6 transition-colors hover:border-teal/50 sm:p-8"
      >
        <h3 class="text-xl">
          I need better information to make decisions
        </h3>

        <p class="mt-3 text-sm leading-relaxed text-white/65">
          Research your market, your stakeholders and your opportunities so the next decision you make is based on evidence, not guesswork.
        </p>

        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-teal">
          Market & Stakeholder Intelligence →
        </span>
      </a>

    </div>
  </section>

  <!-- Want to explore first? -->
  <section class="border-t border-white/10 bg-white/[0.02]">
    <div class="mx-auto max-w-content px-6 py-20 md:px-10 md:py-24">

      <h2 class="text-2xl sm:text-3xl">
        Want to explore first?
      </h2>

      <div class="mt-8 grid gap-5 sm:grid-cols-2">

        <a
          href="/insights"
          class="group rounded border border-white/10 p-6 transition-colors hover:border-teal/50 sm:p-8"
        >
          <h3 class="text-xl">
            Explore our Insights
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-white/65">
            Our latest thinking on partnerships, communities, data and the systems behind sustainable growth.
          </p>

          <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-teal">
            Explore Insights →
          </span>
        </a>

        <a
          href="/resources"
          class="group rounded border border-white/10 p-6 transition-colors hover:border-teal/50 sm:p-8"
        >
          <h3 class="text-xl">
            Explore our Resources
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-white/65">
            Practical templates, frameworks and guides you can put to use right away.
          </p>

          <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-teal">
            Explore Resources →
          </span>
        </a>

      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section
    id="newsletter"
    class="mx-auto max-w-content px-6 py-20 md:px-10 md:py-24"
  >
    <Newsletter />
  </section>

  <!-- Closing CTA -->
  <section class="border-t border-white/10">
    <div class="mx-auto flex max-w-content flex-col items-start justify-between gap-6 px-6 py-16 md:flex-row md:items-center md:px-10 md:py-20">

      <h2 class="max-w-lg text-2xl sm:text-3xl">
        Ready to build better systems around your relationships?
      </h2>

      <a
        href="/contact"
        class="shrink-0 rounded bg-teal px-6 py-3 text-sm font-medium text-navy transition-colors hover:bg-teal-deep hover:text-white"
      >
        Contact Us
      </a>

    </div>
  </section>
</Layout>