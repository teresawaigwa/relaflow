---
import Layout from '../layouts/Layout.astro';
import Newsletter from '../components/Newsletter.astro';
---

<Layout
  title="Relaflow The Business of Relationships"
  description="Relaflow explores the processes, workflows, and systems organizations use to build, manage, and sustain the relationships they depend on."
>

  <!-- HERO -->
  <section class="relative min-h-[88vh] overflow-hidden bg-[#0B1B2E]">

    <img
      src="/images/team-meeting.jpg"
      alt="People gathered around a table during a team meeting"
      class="absolute inset-0 h-full w-full object-cover"
    />

    <div class="absolute inset-0 bg-[#0B1B2E]/55"></div>

    <div class="relative flex min-h-[88vh] items-end">
      <div class="mx-auto w-full max-w-content px-6 pb-16 md:px-10 md:pb-24 lg:pb-28">

        <h1 class="max-w-6xl text-5xl font-medium leading-[0.94] tracking-[-0.03em] text-white sm:text-6xl md:text-7xl lg:text-[7rem]">
          The business of relationships
        </h1>

      </div>
    </div>

  </section>


  <!-- WELCOME -->
  <section class="bg-white">

    <div class="mx-auto max-w-content px-6 py-24 md:px-10 md:py-32 lg:py-36">

      <div class="border-b border-[#0B1B2E]/10 pb-14 md:pb-16">

        <p class="text-base font-bold uppercase tracking-[0.2em] text-[#087D86]">
          Welcome to Relaflow
        </p>

        <div class="mt-6 h-1 w-16 bg-[#14B8C4]"></div>

      </div>


      <div class="mt-14 md:mt-16">

        <h2 class="max-w-6xl text-4xl font-medium leading-[1.02] tracking-[-0.02em] text-[#0B1B2E] sm:text-5xl md:text-6xl lg:text-7xl">
          The systems behind lasting relationships
        </h2>


        <div class="mt-12 w-full space-y-7 text-base leading-8 text-[#0B1B2E]/65 md:text-lg lg:text-xl lg:leading-9">

          <p>
            Relaflow designs and improves the systems behind how organizations
            build and manage relationships with clients, partners, sponsors,
            stakeholders, and communities.
          </p>

          <p>
            We focus on how organizations find, acquire, manage, retain,
            re-engage, and develop relationships. We identify gaps and create
            practical systems that make the work more consistent, organized,
            and sustainable.
          </p>

          <p>
            Our work sits between relationship strategy and operational
            execution.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- EXPERTISE -->
  <section class="bg-[#0B1B2E] text-white">

    <div class="mx-auto max-w-content px-6 py-24 md:px-10 md:py-32 lg:py-40">

      <div class="mb-16">

        <p class="text-base font-bold uppercase tracking-[0.2em] text-[#14B8C4]">
          Our Expertise
        </p>

        <div class="mt-6 h-1 w-16 bg-[#14B8C4]"></div>

      </div>


      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

        <!-- CLIENTS -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-[#14B8C4]/30 bg-[#087D86]/20 p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[#14B8C4]/70 hover:bg-[#087D86]/30"
        >

          <div class="absolute -right-12 -top-12 h-32 w-32 rounded-full bg-[#14B8C4]/20 blur-3xl transition-all duration-300 group-hover:bg-[#14B8C4]/35"></div>

          <div class="relative">

            <h3 class="text-2xl font-medium tracking-tight text-white">
              Clients
            </h3>

            <p class="mt-4 text-base leading-7 text-white/60">
              Processes organizations use to acquire, manage, and retain
              client relationships.
            </p>

          </div>

        </div>


        <!-- PARTNERS -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-[#14B8C4]/30 bg-[#087D86]/20 p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[#14B8C4]/70 hover:bg-[#087D86]/30"
        >

          <div class="absolute -right-12 -top-12 h-32 w-32 rounded-full bg-[#14B8C4]/20 blur-3xl transition-all duration-300 group-hover:bg-[#14B8C4]/35"></div>

          <div class="relative">

            <h3 class="text-2xl font-medium tracking-tight text-white">
              Partners and Sponsors
            </h3>

            <p class="mt-4 text-base leading-7 text-white/60">
              Systems that support partner and sponsor development,
              communication, management, and long-term relationships.
            </p>

          </div>

        </div>


        <!-- EVENTS -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-[#14B8C4]/30 bg-[#087D86]/20 p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[#14B8C4]/70 hover:bg-[#087D86]/30"
        >

          <div class="absolute -right-12 -top-12 h-32 w-32 rounded-full bg-[#14B8C4]/20 blur-3xl transition-all duration-300 group-hover:bg-[#14B8C4]/35"></div>

          <div class="relative">

            <h3 class="text-2xl font-medium tracking-tight text-white">
              Events and Communities
            </h3>

            <p class="mt-4 text-base leading-7 text-white/60">
              Processes that help organizations manage relationships before,
              during, and after events and across communities.
            </p>

          </div>

        </div>


        <!-- STAKEHOLDERS -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-[#14B8C4]/30 bg-[#087D86]/20 p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[#14B8C4]/70 hover:bg-[#087D86]/30"
        >

          <div class="absolute -right-12 -top-12 h-32 w-32 rounded-full bg-[#14B8C4]/20 blur-3xl transition-all duration-300 group-hover:bg-[#14B8C4]/35"></div>

          <div class="relative">

            <h3 class="text-2xl font-medium tracking-tight text-white">
              Stakeholders
            </h3>

            <p class="mt-4 text-base leading-7 text-white/60">
              Systems for understanding, coordinating, and maintaining
              relationships with the people and groups an organization
              depends on.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- INSIGHTS -->
  <section class="bg-[#F4F7F7]">

    <div class="mx-auto max-w-content px-6 py-24 md:px-10 md:py-32 lg:py-36">

      <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">

        <div class="lg:col-span-7">

          <p class="text-base font-bold uppercase tracking-[0.2em] text-[#087D86]">
            Insights
          </p>

          <div class="mt-6 h-1 w-16 bg-[#14B8C4]"></div>

          <h2 class="mt-7 max-w-4xl text-4xl font-medium leading-[1.05] tracking-tight text-[#0B1B2E] sm:text-5xl md:text-6xl">
            Thinking about the work behind relationship systems
          </h2>

        </div>


        <div class="flex flex-col justify-end lg:col-span-4 lg:col-start-9">

          <p class="text-lg leading-8 text-[#0B1B2E]/60">
            Original research, observations, and practical thinking about the
            processes, workflows, and systems organizations use to manage the
            relationships they depend on.
          </p>

          <a
            href="/insights"
            class="group mt-8 inline-flex items-center gap-3 text-sm font-bold text-[#087D86]"
          >
            Explore Insights
            <span class="text-lg transition-transform group-hover:translate-x-1">
              →
            </span>
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- RESOURCES -->
  <section class="bg-[#F4F7F7]">

    <div class="mx-auto max-w-content px-6 py-24 md:px-10 md:py-32 lg:py-36">

      <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">

        <div class="lg:col-span-5">

          <p class="text-base font-bold uppercase tracking-[0.2em] text-[#087D86]">
            Resources
          </p>

          <div class="mt-6 h-1 w-16 bg-[#14B8C4]"></div>

          <h2 class="mt-7 max-w-lg text-4xl font-medium leading-[1.05] tracking-tight text-[#0B1B2E] sm:text-5xl md:text-6xl">
            Practical tools for the work behind relationships
          </h2>

        </div>


        <div class="lg:col-span-6 lg:col-start-7">

          <p class="max-w-2xl text-lg leading-8 text-[#0B1B2E]/60">
            Guides, frameworks, templates, and training designed to help
            organizations turn relationship work into clearer, more
            repeatable processes.
          </p>


          <div class="mt-12 border-t border-[#14B8C4]/60">

            <a
              href="/resources"
              class="group flex items-start justify-between gap-8 border-b border-[#14B8C4]/60 py-7"
            >

              <div>

                <h3 class="text-xl font-medium text-[#0B1B2E] transition-colors group-hover:text-[#087D86]">
                  Guides and Frameworks
                </h3>

                <p class="mt-2 max-w-lg text-sm leading-6 text-[#0B1B2E]/55">
                  Practical ways to understand, structure, and improve
                  relationship work.
                </p>

              </div>

              <span class="shrink-0 text-xl text-[#14B8C4] transition-transform group-hover:translate-x-1">
                →
              </span>

            </a>


            <a
              href="/resources"
              class="group flex items-start justify-between gap-8 border-b border-[#14B8C4]/60 py-7"
            >

              <div>

                <h3 class="text-xl font-medium text-[#0B1B2E] transition-colors group-hover:text-[#087D86]">
                  Templates and Training
                </h3>

                <p class="mt-2 max-w-lg text-sm leading-6 text-[#0B1B2E]/55">
                  Tools and learning resources for putting better processes
                  into practice.
                </p>

              </div>

              <span class="shrink-0 text-xl text-[#14B8C4] transition-transform group-hover:translate-x-1">
                →
              </span>

            </a>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- NEWSLETTER -->
  <section class="bg-[#0B1B2E] text-white">

    <div class="mx-auto max-w-content px-6 py-20 md:px-10 md:py-28">

      <Newsletter />

    </div>

  </section>


  <!-- CONTACT -->
  <section class="relative min-h-[72vh] overflow-hidden bg-[#0B1B2E]">

    <img
      src="/images/teal-water.jpg"
      alt="Teal water"
      class="absolute inset-0 h-full w-full object-cover"
    />

    <div class="absolute inset-0 bg-[#0B1B2E]/55"></div>

    <div class="relative flex min-h-[72vh] items-end">

      <div class="mx-auto w-full max-w-content px-6 pb-10 md:px-10 md:pb-16 lg:pb-20">

        <div class="max-w-5xl">

          <h2 class="max-w-4xl text-3xl font-medium leading-[1.04] tracking-tight text-white sm:text-4xl md:text-5xl lg:text-6xl">
            Ready to improve your relationship systems?
          </h2>

          <a
            href="/contact"
            class="group mt-9 inline-flex items-center gap-3 rounded-full bg-[#14B8C4] px-7 py-3.5 text-sm font-bold text-[#0B1B2E] transition-all hover:-translate-y-0.5 hover:bg-[#14B8C4]/90"
          >
            Contact Us
            <span class="text-lg transition-transform group-hover:translate-x-1">
              →
            </span>
          </a>

        </div>

      </div>

    </div>

  </section>


</Layout>