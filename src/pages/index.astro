---
import Layout from '../layouts/Layout.astro';
import FlowLine from '../components/FlowLine.astro';
import Newsletter from '../components/Newsletter.astro';
---

<Layout
  title="Relaflow | The Business of Relationships"
  description="Relaflow is a modern media, training and advisory brand focused on the relationships that organizations depend on."
>
  <!-- Hero -->
  <section class="mx-auto max-w-content px-6 pt-20 pb-16 md:px-10 md:pt-28 md:pb-24">
    <div class="max-w-3xl">
      <p class="font-display text-sm uppercase tracking-widest2 text-teal">
        Welcome to Relaflow
      </p>

      <h1 class="mt-5 text-4xl leading-[1.1] sm:text-5xl md:text-6xl">
        The business of relationships.
      </h1>

      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-white/75">
        Relaflow is a modern media, training and advisory brand focused on the relationships that organizations depend on.
      </p>

      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/75">
        We explore how organizations find, build, manage and retain relationships with clients, partners, sponsors, communities and other stakeholders.
      </p>

      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/75">
        Through insights, research, practical resources, training and selected advisory work, Relaflow helps organizations understand their relationship landscape, identify opportunities and improve the practices, information and systems behind relationship-driven work.
      </p>
    </div>

    <FlowLine nodes={6} class="mt-16 h-8" />
  </section>

  <!-- What We Do -->
  <section class="mx-auto max-w-content px-6 pb-20 md:px-10 md:pb-28">
    <h2 class="text-2xl sm:text-3xl">
      What We Do
    </h2>

    <p class="mt-4 max-w-2xl text-white/65">
      Relaflow brings together research, learning and practical support around the business of relationships.
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-3">

      <a
        href="/insights"
        class="group rounded border border-white/10 p-6 transition-colors hover:border-teal/50 sm:p-8"
      >
        <h3 class="text-xl">
          Media and Insights
        </h3>

        <p class="mt-3 text-sm leading-relaxed text-white/65">
          Research, ideas and practical thinking about organizational relationships, networks, opportunities and the practices behind them.
        </p>

        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-teal">
          Explore Insights →
        </span>
      </a>

      <a
        href="/resources"
        class="group rounded border border-white/10 p-6 transition-colors hover:border-teal/50 sm:p-8"
      >
        <h3 class="text-xl">
          Training and Frameworks
        </h3>

        <p class="mt-3 text-sm leading-relaxed text-white/65">
          Masterclasses, playbooks and practical frameworks that help teams understand and improve relationship-related work.
        </p>

        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-teal">
          Explore Resources →
        </span>
      </a>

      <a
        href="/contact"
        class="group rounded border border-white/10 p-6 transition-colors hover:border-teal/50 sm:p-8"
      >
        <h3 class="text-xl">
          Strategic Advisory
        </h3>

        <p class="mt-3 text-sm leading-relaxed text-white/65">
          Focused support for organizations working through relationship, research, data or operational challenges.
        </p>

        <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-teal">
          Contact Us →
        </span>
      </a>

    </div>
  </section>

  <!-- Our Expertise -->
  <section class="border-t border-white/10 bg-white/[0.02]">
    <div class="mx-auto max-w-content px-6 py-20 md:px-10 md:py-24">

      <h2 class="text-2xl sm:text-3xl">
        Our Expertise
      </h2>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">

        <div class="rounded border border-white/10 p-6 sm:p-8">
          <h3 class="text-xl">
            Client Relationships
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-white/65">
            Understanding how organizations find, develop, manage and retain clients.
          </p>
        </div>

        <div class="rounded border border-white/10 p-6 sm:p-8">
          <h3 class="text-xl">
            Partnerships and Sponsorships
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-white/65">
            Understanding opportunities, developing partner relationships and supporting long-term partnerships and sponsorships.
          </p>
        </div>

        <div class="rounded border border-white/10 p-6 sm:p-8">
          <h3 class="text-xl">
            Events and Communities
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-white/65">
            Understanding audiences, improving engagement and building relationships that continue beyond individual events and interactions.
          </p>
        </div>

        <div class="rounded border border-white/10 p-6 sm:p-8">
          <h3 class="text-xl">
            Relationship Operations
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-white/65">
            The information, processes and systems that help organizations manage relationships consistently.
          </p>
        </div>

        <div class="rounded border border-white/10 p-6 sm:p-8">
          <h3 class="text-xl">
            Research and Data
          </h3>

          <p class="mt-3 text-sm leading-relaxed text-white/65">
            Understanding markets, stakeholders, networks, opportunities and the information behind better decisions.
          </p>
        </div>

      </div>

      <a
        href="/contact"
        class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-teal"
      >
        Want to work with us? Contact Us →
      </a>

    </div>
  </section>

  <!-- Insights -->
  <section class="mx-auto max-w-content px-6 py-20 md:px-10 md:py-24">

    <h2 class="text-2xl sm:text-3xl">
      Insights
    </h2>

    <p class="mt-4 max-w-2xl text-white/65">
      Relaflow publishes practical thinking on the relationships that influence organizational growth, retention and long-term development.
    </p>

    <a
      href="/insights"
      class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-teal"
    >
      Explore Insights →
    </a>

  </section>

  <!-- Resources -->
  <section class="border-t border-white/10 bg-white/[0.02]">
    <div class="mx-auto max-w-content px-6 py-20 md:px-10 md:py-24">

      <h2 class="text-2xl sm:text-3xl">
        Resources
      </h2>

      <p class="mt-4 max-w-2xl text-white/65">
        Explore guides, templates, frameworks and training designed to help organizations understand and improve how they manage relationships.
      </p>

      <a
        href="/resources"
        class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-teal"
      >
        Explore Resources →
      </a>

    </div>
  </section>

  <!-- Newsletter -->
  <section
    id="newsletter"
    class="mx-auto max-w-content px-6 py-20 md:px-10 md:py-24"
  >
    <Newsletter />
  </section>

  <!-- Closing CTA -->
  <section class="border-t border-white/10">
    <div class="mx-auto flex max-w-content flex-col items-start justify-between gap-6 px-6 py-16 md:flex-row md:items-center md:px-10 md:py-20">

      <h2 class="max-w-lg text-2xl sm:text-3xl">
        Have a relationship challenge?
      </h2>

      <a
        href="/contact"
        class="shrink-0 rounded bg-teal px-6 py-3 text-sm font-medium text-navy transition-colors hover:bg-teal-deep hover:text-white"
      >
        Contact Us
      </a>

    </div>
  </section>
</Layout>