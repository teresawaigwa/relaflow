---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const insights = await getCollection(
    'insights',
    ({ data }) => !data.draft
  );

  return insights.map((insight) => ({
    params: {
      slug: insight.id,
    },
    props: {
      insight,
    },
  }));
}

const { insight } = Astro.props;
const { Content } = await render(insight);

const categoryNames: Record<string, string> = {
  'client-relationships': 'Client Relationships',
  'partnerships-sponsorships': 'Partnerships & Sponsorships',
  'events-communities': 'Events & Communities',
  'relationship-operations': 'Relationship Operations',
  'research-data': 'Research & Data',
};

const category =
  categoryNames[insight.data.category] ?? 'Insights';
---

<Layout
  title={`${insight.data.title} | Relaflow`}
  description={insight.data.description}
>
  <article class="mx-auto max-w-content px-6 py-20 md:px-10 md:py-28">

    <!-- Header -->
    <header class="max-w-3xl">

      <a
        href="/insights"
        class="inline-flex items-center gap-2 text-sm text-teal hover:text-white"
      >
        ← Back to Insights
      </a>

      <p class="mt-10 font-display text-sm uppercase tracking-widest2 text-teal">
        {category}
      </p>

      <h1 class="mt-4 text-4xl leading-[1.1] sm:text-5xl md:text-6xl">
        {insight.data.title}
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-white/70">
        {insight.data.description}
      </p>

    </header>

    <!-- Insight Content -->
    <div
      class="prose-body mt-14 max-w-3xl text-base leading-[1.8] text-white/75 sm:text-lg"
    >
      <Content />
    </div>

    <!-- Back to Insights -->
    <div class="mt-16 border-t border-white/10 pt-8">
      <a
        href="/insights"
        class="inline-flex items-center gap-2 text-sm font-medium text-teal hover:text-white"
      >
        ← Explore More Insights
      </a>
    </div>

  </article>
</Layout>