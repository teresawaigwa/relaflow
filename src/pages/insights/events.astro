---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

const events = await getCollection('events');
---

<Layout
  title="Events & Conversations"
  description="Bringing people together to explore better ways of working. Follow Relaflow's upcoming events, conversations, webinars and discussions around partnerships, communities, data, operations and sustainable growth."
>
  <PageHero
    eyebrow="Insights"
    title="Bringing people together to explore better ways of working."
    lede="Follow Relaflow's upcoming events, conversations, webinars and discussions around partnerships, communities, data, operations and sustainable growth."
  />

  <section class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-20">
    {events.length === 0 ? (
      <div class="rounded border border-dashed border-white/15 px-6 py-14 text-center">
        <p class="text-white/70">Nothing scheduled right now.</p>
        <p class="mt-2 text-sm text-white/50">Check back soon, or subscribe to hear about new events first.</p>
        <a href="/#newsletter" class="mt-6 inline-block text-sm font-medium text-teal hover:text-white">→ Subscribe</a>
      </div>
    ) : (
      <ul class="divide-y divide-white/10 border-y border-white/10">
        {events.map((event) => (
          <li class="py-6">
            <p class="text-lg text-white">{event.data.title}</p>
            {event.data.date && <p class="mt-1 text-sm text-teal">{event.data.date}</p>}
            {event.data.description && <p class="mt-2 max-w-xl text-sm text-white/65">{event.data.description}</p>}
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
