---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter((e) => !e.data.draft)
  .slice(0, 3);

const events = (await getCollection('events'))
  .filter((e) => !e.data.draft);
---

<Layout
  title="Insights | Relaflow's Thinking on Partnerships, Community and Data"
  description="Practical ideas and research from Relaflow on partnerships, communities, CRM, data and the systems behind sustainable growth."
>
  <PageHero
    eyebrow="Insights"
    title="Ideas, research and practical thinking from Relaflow."
    lede="We explore partnerships, communities, CRM, data, operations and the systems that support sustainable growth. Nothing here is written to sell you something, it's written because we think it's genuinely useful."
  />

  <section class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-20">
    <div class="flex items-baseline justify-between">
      <h2 class="text-2xl sm:text-3xl">Articles</h2>

      <a
        href="/insights/articles"
        class="text-sm font-medium text-teal hover:text-white"
      >
        View all
      </a>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {articles.map((article) => (
        <a
          href={`/insights/articles/${article.slug}`}
          class="group flex flex-col justify-between rounded border border-white/10 bg-white/[0.03] p-6 transition-colors hover:border-teal/50"
        >
          <div>
            <h3 class="text-lg leading-snug text-white">
              {article.data.title}
            </h3>

            <p class="mt-3 text-sm leading-relaxed text-white/65">
              {article.data.description}
            </p>
          </div>

          <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-teal">
            Read Article

            <svg
              class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
              viewBox="0 0 14 14"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2 7h10M8 3l4 4-4 4"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  {events.length > 0 && (
    <section class="border-t border-white/10">
      <div class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-20">
        <div class="flex items-baseline justify-between">
          <h2 class="text-2xl sm:text-3xl">
            Events & Conversations
          </h2>

          <a
            href="/insights/events"
            class="text-sm font-medium text-teal hover:text-white"
          >
            View all
          </a>
        </div>

        <p class="mt-4 max-w-xl text-white/70">
          Bringing people together to explore better ways of working.
          Follow Relaflow's upcoming events, conversations, webinars and
          discussions around partnerships, communities, data, operations
          and sustainable growth.
        </p>
      </div>
    </section>
  )}
</Layout>