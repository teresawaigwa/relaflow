---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allInsights = await getCollection(
  'insights',
  ({ data }) => !data.draft
);

const expertiseAreas = [
  {
    slug: 'client-relationships',
    title: 'Client Relationships',
    description:
      'Client acquisition, relationship development, retention, loyalty and the information behind them.',
  },
  {
    slug: 'partnerships-sponsorships',
    title: 'Partnerships and Sponsorships',
    description:
      'Finding potential partners, developing relationships, managing opportunities and understanding what makes partnerships last.',
  },
  {
    slug: 'events-communities',
    title: 'Events and Communities',
    description:
      'Understanding audiences, developing communities, increasing participation and building relationships that continue after an event or interaction.',
  },
  {
    slug: 'relationship-operations',
    title: 'Relationship Operations',
    description:
      'The practical work behind managing relationships, from relationship data and CRM to follow-up, processes and workflows.',
  },
  {
    slug: 'research-data',
    title: 'Research and Data',
    description:
      'Markets, stakeholders, networks, opportunities and the information organizations need to make better decisions.',
  },
];
---

<Layout
  title="Insights | The Business of Relationships"
  description="Relaflow publishes practical thinking on the relationships that influence organizational growth, retention and long-term development."
>
  <!-- Hero -->
  <section class="mx-auto max-w-content px-6 pt-20 pb-16 md:px-10 md:pt-28 md:pb-20">
    <div class="max-w-3xl">
      <p class="font-display text-sm uppercase tracking-widest2 text-teal">
        Insights
      </p>

      <h1 class="mt-5 text-4xl leading-[1.1] sm:text-5xl md:text-6xl">
        Thinking about the business of relationships.
      </h1>

      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-white/75">
        Relaflow publishes practical thinking on the relationships that influence
        organizational growth, retention and long-term development.
      </p>

      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/75">
        We explore the ideas, practices, information and systems behind how
        organizations find, build, manage and retain relationships.
      </p>
    </div>
  </section>

  <!-- Expertise Areas -->
  {expertiseAreas.map((area, index) => {
    const insights = allInsights.filter(
      (insight) => insight.data.category === area.slug
    );

    return (
      <section
        class:list={[
          'border-t border-white/10',
          index % 2 === 0 ? 'bg-white/[0.02]' : '',
        ]}
      >
        <div class="mx-auto max-w-content px-6 py-20 md:px-10 md:py-24">

          <div class="max-w-3xl">
            <h2 class="text-2xl sm:text-3xl">
              {area.title}
            </h2>

            <p class="mt-4 text-white/65">
              {area.description}
            </p>
          </div>

          {insights.length > 0 ? (
            <div class="mt-8 grid gap-5 md:grid-cols-2">
              {insights.map((insight) => (
                <a
                  href={`/insights/${insight.id}/`}
                  class="group block rounded border border-white/10 p-6 transition-colors hover:border-teal/50 sm:p-8"
                >
                  <p class="font-display text-sm uppercase tracking-widest2 text-teal">
                    Insight
                  </p>

                  <h3 class="mt-3 text-xl leading-snug transition-colors group-hover:text-teal sm:text-2xl">
                    {insight.data.title}
                  </h3>

                  <p class="mt-4 text-sm leading-relaxed text-white/65">
                    {insight.data.description}
                  </p>

                  <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-teal">
                    Read Insight →
                  </span>
                </a>
              ))}
            </div>
          ) : (
            <div class="mt-8 rounded border border-dashed border-white/10 p-6 sm:p-8">
              <p class="text-sm text-white/50">
                New insights in this area are coming soon.
              </p>
            </div>
          )}

        </div>
      </section>
    );
  })}

  <!-- Newsletter CTA -->
  <section class="mx-auto max-w-content px-6 py-20 md:px-10 md:py-24">
    <div class="rounded border border-white/10 bg-white/[0.03] px-6 py-10 sm:px-12 sm:py-14">
      <div class="max-w-2xl">
        <p class="font-display text-sm uppercase tracking-widest2 text-teal">
          Stay Connected
        </p>

        <h2 class="mt-4 text-2xl sm:text-3xl">
          The Business of Relationships Brief
        </h2>

        <p class="mt-4 text-white/65">
          Get new insights, research, conversations and practical resources
          from Relaflow.
        </p>

        <a
          href="/#newsletter"
          class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-teal"
        >
          Subscribe →
        </a>
      </div>
    </div>
  </section>
</Layout>