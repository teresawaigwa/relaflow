---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).filter((e) => !e.data.draft);
---

<Layout
  title="Articles"
  description="Read our latest thinking on partnerships, communities, data, operations and sustainable growth."
>
  <PageHero eyebrow="Insights" title="Articles" />

  <section class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-20">
    <div class="divide-y divide-white/10 border-y border-white/10">
      {articles.map((article) => (
        <a href={`/insights/articles/${article.slug}`} class="group flex items-center justify-between gap-6 py-6">
          <div>
            <h2 class="text-lg text-white group-hover:text-teal sm:text-xl">{article.data.title}</h2>
            <p class="mt-2 max-w-xl text-sm text-white/65">{article.data.description}</p>
          </div>
          <span class="hidden shrink-0 items-center gap-1.5 text-sm font-medium text-teal sm:inline-flex">
            Read Article
            <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>
