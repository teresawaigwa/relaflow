---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<Layout title={service.title} description={service.tagline}>
  <PageHero eyebrow="What We Do" title={service.tagline} />

  <section class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-20">
    <div class="grid gap-12 md:grid-cols-[1.2fr_1fr]">
      <p class="max-w-xl text-lg leading-relaxed text-white/80">{service.intro}</p>

      <div>
        <h2 class="font-display text-sm uppercase tracking-widest2 text-white/50">We can help with</h2>
        <ul class="mt-5 space-y-3">
          {service.bullets.map((bullet) => (
            <li class="flex items-start gap-3 text-white/85">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-teal"></span>
              {bullet}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="border-t border-white/10">
    <div class="mx-auto flex max-w-content flex-col items-start justify-between gap-6 px-6 py-16 md:flex-row md:items-center md:px-10 md:py-20">
      <div>
        <h2 class="text-2xl sm:text-3xl">Have a relationship or operations challenge?</h2>
        <p class="mt-3 text-white/70">Tell us what you're trying to build.</p>
      </div>
      <a
        href="/contact"
        class="shrink-0 rounded bg-teal px-6 py-3 text-sm font-medium text-navy transition-colors hover:bg-teal-deep hover:text-white"
      >
        Work With Us
      </a>
    </div>
  </section>
</Layout>
