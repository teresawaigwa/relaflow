---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ResourceList from '../../components/ResourceList.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).filter((e) => !e.data.draft);
const items = guides.map((g) => ({ title: g.data.title, description: g.data.description }));
---

<Layout
  title="Guides"
  description="Practical, in-depth resources covering partnerships, communities, CRM, data and operations."
>
  <PageHero
    eyebrow="Resources"
    title="Go deeper on the problems that matter."
    lede="Practical, in-depth resources covering partnerships, communities, CRM, data and operations."
  />

  <section class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-20">
    <ResourceList items={items} />
  </section>
</Layout>
