---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Guides | Relaflow"
  description="Practical guides from Relaflow on relationships, operations and sustainable growth."
>
  <section class="mx-auto max-w-content px-6 py-24 md:px-10 md:py-32">
    <div class="max-w-2xl">
      <p class="font-display text-sm uppercase tracking-widest2 text-teal">
        Guides
      </p>

      <h1 class="mt-5 text-4xl leading-tight sm:text-5xl">
        Practical guides are coming soon.
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-white/70">
        We are developing practical guides to help organizations make better decisions about relationships, operations and growth.
      </p>

      <a
        href="/resources"
        class="mt-8 inline-flex items-center text-sm font-medium text-teal hover:text-white transition-colors"
      >
        ← Back to Resources
      </a>
    </div>
  </section>
</Layout>