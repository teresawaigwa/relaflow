---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<div class="border-b border-white/10">
  <div class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-20">
    {eyebrow && <p class="font-display text-sm uppercase tracking-widest2 text-teal">{eyebrow}</p>}
    <h1 class="mt-4 max-w-3xl text-3xl sm:text-4xl md:text-5xl">{title}</h1>
    {lede && <p class="mt-5 max-w-2xl text-lg text-white/70">{lede}</p>}
  </div>
</div>
