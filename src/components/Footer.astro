---
import { footerExplore, socialLinks } from '../data/nav';
import FlowLine from './FlowLine.astro';
---

<footer class="border-t border-white/10">
  <div class="mx-auto max-w-content px-6 pt-14 md:px-10">
    <FlowLine nodes={5} class="mb-14 h-6 opacity-70" />
  </div>

  <div class="mx-auto grid max-w-content gap-12 px-6 pb-14 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:px-10">
    <div>
      <span class="font-display text-lg font-semibold">
        <span class="text-white">RELA</span><span class="text-teal">FLOW</span>
      </span>
      <p class="mt-3 text-sm text-grey">Systems for Sustainable Growth</p>
      <p class="mt-4 max-w-xs text-sm text-white/60">
        Relaflow builds data and operations infrastructure for relationship-driven organizations.
      </p>
    </div>

    <div>
      <h3 class="font-display text-sm uppercase tracking-widest2 text-white/50">Explore</h3>
      <ul class="mt-4 space-y-2.5">
        {footerExplore.map((item) => (
          <li><a href={item.href} class="text-sm text-white/75 hover:text-teal">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="font-display text-sm uppercase tracking-widest2 text-white/50">Connect</h3>
      <ul class="mt-4 space-y-2.5">
        {socialLinks.map((item) => (
          <li>
            <a href={item.href} target="_blank" rel="noreferrer noopener" class="text-sm text-white/75 hover:text-teal">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="font-display text-sm uppercase tracking-widest2 text-white/50">Stay Connected</h3>
      <p class="mt-4 text-sm text-white/75">The Relationship Infrastructure Brief</p>
      <a href="/#newsletter" class="mt-2 inline-block text-sm text-teal hover:text-white">→ Subscribe</a>

      <h3 class="mt-8 font-display text-sm uppercase tracking-widest2 text-white/50">Contact</h3>
      <a href="mailto:hello@relaflow.com" class="mt-2 inline-block text-sm text-white/75 hover:text-teal">
        hello@relaflow.com
      </a>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-content flex-col gap-4 px-6 py-6 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between md:px-10">
      <p>&copy; {new Date().getFullYear()} Relaflow. All rights reserved.</p>
      <div class="flex gap-5">
        <a href="/legal/privacy-policy" class="hover:text-teal">Privacy Policy</a>
        <a href="/legal/terms" class="hover:text-teal">Terms</a>
      </div>
    </div>
  </div>
</footer>
