    </svg>
  )}
  {icon === 'events' && (
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="4" y="5" width="16" height="15" rx="1.5" stroke="#02EEF5" stroke-width="1.5" />
      <line x1="4" y1="9.5" x2="20" y2="9.5" stroke="#02EEF5" stroke-width="1.5" />
      <line x1="8" y1="3" x2="8" y2="6.5" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
      <line x1="16" y1="3" x2="16" y2="6.5" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
      <circle cx="9" cy="14" r="1.1" fill="#02EEF5" />
      <circle cx="13" cy="14" r="1.1" fill="#02EEF5" fill-opacity="0.5" />
      <circle cx="9" cy="17.3" r="1.1" fill="#02EEF5" fill-opacity="0.5" />
    </svg>
  )}
  {icon === 'research' && (
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <line x1="5" y1="19" x2="5" y2="12" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
      <line x1="10" y1="19" x2="10" y2="8" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
      <line x1="15" y1="19" x2="15" y2="11" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
      <line x1="19" y1="19" x2="19" y2="5" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  )}
