      <path d="M17 10v2a2 2 0 0 1-2 2h-1" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  )}
  {icon === 'community' && (
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
