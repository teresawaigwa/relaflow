---
interface Props {
  icon: 'insights' | 'advisory' | 'training' | 'operations' | 'clients' | 'partnerships' | 'events' | 'research' | 'selfrun' | 'repeatable' | 'simple' | 'ongoing' | 'guide' | 'template' | 'framework' | 'community' | 'crm';
  class?: string;
}
const { icon, class: className = '' } = Astro.props;
---
<span class={`relative inline-flex h-14 w-14 items-center justify-center rounded-full border border-teal/40 bg-teal/5 transition-colors group-hover:border-teal group-hover:bg-teal/10 ${className}`}>
  {icon === 'insights' && (
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="5" y="4" width="11" height="16" rx="1" stroke="#02EEF5" stroke-width="1.5" />
      <line x1="8" y1="8" x2="13" y2="8" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
      <line x1="8" y1="11" x2="13" y2="11" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
      <circle cx="16.5" cy="15.5" r="3" stroke="#02EEF5" stroke-width="1.5" />
      <line x1="18.6" y1="17.6" x2="20.5" y2="19.5" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  )}
  {icon === 'advisory' && (
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="9" cy="8" r="3" stroke="#02EEF5" stroke-width="1.5" />
      <path d="M4 19c0-2.8 2.2-5 5-5s5 2.2 5 5" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
      <circle cx="17" cy="7" r="2.2" stroke="#02EEF5" stroke-width="1.5" />
      <path d="M14.5 19c0-2.2 1.2-4 3-4.6" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  )}
  {icon === 'training' && (
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="4" y="4" width="7" height="7" rx="1" stroke="#02EEF5" stroke-width="1.5" />
      <rect x="13" y="4" width="7" height="7" rx="1" stroke="#02EEF5" stroke-width="1.5" stroke-opacity="0.5" />
      <rect x="4" y="13" width="7" height="7" rx="1" stroke="#02EEF5" stroke-width="1.5" stroke-opacity="0.5" />
      <path d="M15 16.2l1.4 1.4 2.6-2.8" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  {icon === 'operations' && (
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="12" cy="12" r="2.2" stroke="#02EEF5" stroke-width="1.5" />
      <circle cx="12" cy="4.5" r="1.6" stroke="#02EEF5" stroke-width="1.5" />
      <circle cx="19" cy="16" r="1.6" stroke="#02EEF5" stroke-width="1.5" />
      <circle cx="5" cy="16" r="1.6" stroke="#02EEF5" stroke-width="1.5" />
      <line x1="12" y1="9.8" x2="12" y2="6.1" stroke="#02EEF5" stroke-width="1.5" />
      <line x1="13.9" y1="13.2" x2="17.5" y2="15.1" stroke="#02EEF5" stroke-width="1.5" />
      <line x1="10.1" y1="13.2" x2="6.5" y2="15.1" stroke="#02EEF5" stroke-width="1.5" />
    </svg>
  )}
  {icon === 'clients' && (
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
