    </svg>
  )}
  {icon === 'simple' && (
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="12" cy="12" r="8" stroke="#02EEF5" stroke-width="1.5" />
      <circle cx="12" cy="12" r="3.2" fill="#02EEF5" fill-opacity="0.7" />
    </svg>
  )}
  {icon === 'ongoing' && (
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M4 12a8 8 0 1 1 3 6.3" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
      <path d="M4 16v-3h3" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  {icon === 'guide' && (
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
