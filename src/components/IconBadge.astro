      <path d="M3.3 19c.4-2.8 2.4-4.8 4.7-4.8s4.3 2 4.7 4.8" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
      <path d="M11.3 14.5c2 .3 3.7 2.1 4.1 4.5" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  )}
  {icon === 'crm' && (
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <ellipse cx="12" cy="6" rx="7" ry="2.5" stroke="#02EEF5" stroke-width="1.5" />
      <path d="M5 6v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5V6" stroke="#02EEF5" stroke-width="1.5" />
      <path d="M5 12v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6" stroke="#02EEF5" stroke-width="1.5" />
    </svg>
  )}
