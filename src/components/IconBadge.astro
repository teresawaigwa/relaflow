      <path d="M5.5 19.5c0-3.6 2.9-6.3 6.5-6.3s6.5 2.7 6.5 6.3" stroke="#02EEF5" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  )}
  {icon === 'partnerships' && (
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
