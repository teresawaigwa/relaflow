      <path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H13v15h5.5c.8 0 1.5.7 1.5 1.5v-15z" stroke="#02EEF5" stroke-width="1.5" stroke-linejoin="round" />
    </svg>
  )}
  {icon === 'template' && (
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="4" y="4" width="16" height="16" rx="1.5" stroke="#02EEF5" stroke-width="1.5" />
      <line x1="4" y1="9.5" x2="20" y2="9.5" stroke="#02EEF5" stroke-width="1.5" />
      <line x1="10" y1="9.5" x2="10" y2="20" stroke="#02EEF5" stroke-width="1.5" />
    </svg>
  )}
  {icon === 'framework' && (
    <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="4" y="4" width="6" height="6" rx="1" stroke="#02EEF5" stroke-width="1.5" />
      <rect x="14" y="4" width="6" height="6" rx="1" stroke="#02EEF5" stroke-width="1.5" stroke-opacity="0.6" />
      <rect x="9" y="14" width="6" height="6" rx="1" stroke="#02EEF5" stroke-width="1.5" stroke-opacity="0.6" />
